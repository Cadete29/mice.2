NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

DB_HOST=localhost
DB_PORT=5432
DB_NAME=mice_lo2
DB_USER=postgres
DB_PASSWORD=change-me
DB_SSL=false

# Genéralo con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_EXPIRES_IN=15m
# Recomendado: una clave distinta de JWT_ACCESS_SECRET, con al menos 32 caracteres.
# MFA_ENCRYPTION_KEY=
CONSENT_HASH_KEY=cambia-esta-clave-de-evidencia-legal-por-una-aleatoria
TERMS_DOCUMENT_SHA256=
PRIVACY_DOCUMENT_SHA256=
REFRESH_TOKEN_DAYS=30
CLEANUP_INTERVAL_MINUTES=60
SESSION_RETENTION_DAYS=30
USED_TOKEN_RETENTION_DAYS=7
TERMS_VERSION=2026-08-08
PRIVACY_VERSION=2026-07-17
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
TRUST_PROXY=false

# Correo: usa "gmail" o "namecheap".
EMAIL_ENABLED=false
EMAIL_PROVIDER=gmail
EMAIL_USER=tu-cuenta@gmail.com
# Gmail requiere una contraseña de aplicación, no la contraseña normal.
EMAIL_PASSWORD=change-me
EMAIL_FROM_NAME=MICE-LO
EMAIL_FROM_ADDRESS=tu-cuenta@gmail.com
ADMIN_EMAIL=administracion@example.com

# Opcional: sobrescribe los valores SMTP del proveedor.
# Gmail: smtp.gmail.com, puerto 465, secure=true
# Namecheap Private Email: mail.privateemail.com, puerto 465, secure=true
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_SECURE=true
# Límites para que una conexión SMTP bloqueada no detenga el arranque de la API.
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=20000
