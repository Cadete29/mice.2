{
  "name": "backend",
  "version": "1.0.0",
  "description": "API de MICE-LO con autenticación segura y PostgreSQL",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:migrate": "node src/scripts/migrate.js",
    "auth:smoke": "node src/scripts/smoke-auth.js",
    "email:verify": "node src/scripts/verify-email.js",
    "admin:promote": "node src/scripts/promote-admin.js",
    "db:cleanup": "node src/scripts/cleanup-auth.js",
    "test": "node --test",
    "test:integration": "node --test --test-concurrency=1 integration/auth.integration.js",
    "test:all": "npm run test && npm run test:integration"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "argon2": "^0.44.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  }
}
